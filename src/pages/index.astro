---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { services } from '../content/services';
import { getFeaturedProjects } from '../content/projects';

const featured = getFeaturedProjects().slice(0, 3);
---

<Layout>
  <Hero />

  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24 cv-auto">
    <div class="flex justify-between items-end gap-4">
      <h2 class="text-2xl font-bold">Cómo puedo ayudarte</h2>
      <a href="/servicios" class="text-sm text-muted hover:text-fg focus-ring rounded shrink-0"
        >Ver todo →</a
      >
    </div>
    <p class="text-sm text-muted mt-2 max-w-2xl">
      Tres formas de trabajar: web nueva o renovación, revisión con plan de mejora, o plan digital
      antes de invertir.
    </p>
    <div class="mt-6 grid md:grid-cols-3 gap-6">
      {services.map((s) => <ServiceCard service={s} />)}
    </div>
    <p class="mt-8 text-sm text-muted max-w-2xl">
      Proceso claro, presupuesto cerrado y entregas definidas.
      <a href="/como-trabajo" class="underline focus-ring rounded">Cómo trabajo</a>
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24 cv-auto">
    <div class="flex justify-between items-end gap-4">
      <h2 class="text-2xl font-bold">Casos reales</h2>
      <a href="/proyectos" class="text-sm text-muted hover:text-fg focus-ring rounded shrink-0"
        >Ver todos →</a
      >
    </div>
    <p class="text-sm text-muted mt-2 max-w-2xl">
      En cada proyecto verás el problema, lo que se hizo y qué cambió.
    </p>
    <div class="mt-6 grid md:grid-cols-2 gap-6 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16 md:py-24 text-center cv-auto">
    <h2 class="text-3xl font-bold">¿Encaja con lo que buscas?</h2>
    <p class="text-muted mt-2 max-w-2xl mx-auto">
      Respuesta directa. Si no encajo, te lo digo en la primera conversación.
    </p>
    <div class="mt-6">
      <a href="/contacto" class="bg-primary text-bg px-6 py-3 rounded-full font-medium focus-ring"
        >Cuéntame qué necesitas</a
      >
    </div>
  </section>
</Layout>
