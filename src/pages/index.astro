---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TestimonialStrip from '../components/TestimonialStrip.astro';
import { services } from '../content/services';
import { getFeaturedProjects } from '../content/projects';

const featured = getFeaturedProjects().slice(0, 3);
---

<Layout>
  <Hero />
  <section class="mx-auto max-w-6xl px-6 mt-14 cv-auto">
    <div class="flex justify-between items-end gap-4">
      <h2 class="text-2xl font-bold">Cómo puedo ayudarte</h2>
      <a href="/servicios" class="text-sm text-muted hover:text-fg focus-ring rounded shrink-0"
        >Ver todo →</a
      >
    </div>
    <p class="text-sm text-muted mt-2 max-w-2xl">
      Tres formas de trabajar: web nueva o renovación, revisión con plan de mejora, o plan digital
      antes de invertir.
    </p>
    <div class="mt-6 grid md:grid-cols-3 gap-6">
      {services.map((s) => <ServiceCard service={s} />)}
    </div>
  </section>

  <TestimonialStrip />

  <section class="mx-auto max-w-6xl px-6 mt-16 cv-auto">
    <div class="flex justify-between items-end gap-4">
      <h2 class="text-2xl font-bold">Casos reales, explicados sin letra pequeña</h2>
      <a href="/proyectos" class="text-sm text-muted hover:text-fg focus-ring rounded shrink-0"
        >Ver todos los casos →</a
      >
    </div>
    <p class="text-sm text-muted mt-2 max-w-2xl">
      En cada proyecto verás cuál era el problema, qué se hizo y qué cambió. Si te interesa la parte
      técnica, también puedes consultar los detalles.
    </p>
    <div class="mt-6 grid md:grid-cols-2 gap-6 lg:grid-cols-3">
      {featured.map((p) => <ProjectCard project={p} />)}
    </div>
  </section>

  <section
    class="mx-auto max-w-6xl px-6 mt-16 border border-border rounded-2xl p-8 bg-card cv-auto"
  >
    <h2 class="text-xl font-bold">Qué puedes esperar al trabajar conmigo</h2>
    <div class="mt-6 grid md:grid-cols-3 gap-6 text-sm">
      <div>
        <div class="text-primary font-medium">Mensaje claro</div>
        <p class="mt-2 text-muted">
          Tu web explica lo que haces de forma que tus clientes lo entienden en pocos segundos.
        </p>
      </div>
      <div>
        <div class="text-primary font-medium">Proceso definido</div>
        <p class="mt-2 text-muted">
          Sabes qué incluye el trabajo, qué no incluye y cuándo validamos cada fase.
          <a href="/como-trabajo" class="underline focus-ring rounded">Ver cómo trabajo</a>.
        </p>
      </div>
      <div>
        <div class="text-primary font-medium">Contacto sencillo</div>
        <p class="mt-2 text-muted">
          Formulario corto o llamada. Te respondo con una primera valoración y los siguientes pasos.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 mt-12 text-center cv-auto">
    <h2 class="text-3xl font-bold">¿Encaja con lo que buscas?</h2>
    <p class="text-muted mt-2">
      Respuesta directa. Si no encajo, te lo digo en la primera conversación.
    </p>
    <div class="mt-6 flex justify-center gap-3 flex-wrap">
      <a href="/contacto" class="bg-primary text-bg px-6 py-3 rounded-full font-medium focus-ring"
        >Cuéntame qué necesitas</a
      >
      <a
        href="https://cal.com/alexendros"
        class="border border-border px-6 py-3 rounded-full focus-ring"
        target="_blank"
        rel="noopener noreferrer">Agendar 15 min</a
      >
    </div>
  </section>
</Layout>
