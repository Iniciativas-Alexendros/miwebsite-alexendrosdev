---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { projects } from '../../content/projects';

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
---

<Layout title={`${project.title} — Alexendros`} description={project.short}>
  <div class="mx-auto max-w-4xl px-6 pt-12">
    <div class="text-xs font-mono text-muted">
      <a href="/proyectos" class="hover:text-fg focus-ring rounded">Proyectos</a> / {project.slug}
    </div>
    <h1 class="mt-3 text-4xl font-bold">{project.title}</h1>
    <p class="mt-3 text-muted">{project.summary}</p>
    <Image
      src={project.cover}
      alt=""
      widths={[800, 1200]}
      sizes="(max-width: 768px) 100vw, 800px"
      class="mt-6 w-full rounded-2xl border border-border"
      loading="eager"
    />
    <div class="mt-4 flex flex-wrap gap-2">
      {
        project.results.map((r) => (
          <span class="text-xs font-mono bg-primary/10 text-primary border border-primary/20 rounded-full px-3 py-1">
            {r}
          </span>
        ))
      }
    </div>

    <div class="mt-10 grid md:grid-cols-[1.2fr_0.8fr] gap-10">
      <div class="space-y-8 text-sm">
        <div>
          <h2 class="font-bold">Contexto</h2><p class="text-muted mt-1">{project.context}</p>
        </div>
        <div><h2 class="font-bold">Reto</h2><p class="text-muted mt-1">{project.challenge}</p></div>
        <div>
          <h2 class="font-bold">Solución</h2><p class="text-muted mt-1">{project.solution}</p>
        </div>
        <div>
          <h2 class="font-bold">Responsabilidades</h2>
          <ul class="list-disc pl-5 text-muted space-y-1 mt-1">
            {project.responsibilities.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
      <div class="space-y-6 cv-auto">
        <div class="border border-border rounded-2xl p-5 bg-card">
          <h2 class="font-bold text-sm">Stack</h2>
          <div class="mt-3 flex flex-wrap gap-2">
            {
              project.technologies.map((t) => (
                <span class="text-xs font-mono border border-border rounded-full px-2 py-1">
                  {t}
                </span>
              ))
            }
          </div>
        </div>
        <div class="border border-border rounded-2xl p-5 bg-card">
          <h2 class="font-bold text-sm">Highlights</h2>
          <ul class="mt-2 list-disc pl-5 text-xs text-muted space-y-1">
            {project.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
        <div class="border border-border rounded-2xl p-5 bg-card">
          <h2 class="font-bold text-sm">Links</h2>
          <div class="mt-2 flex gap-3 text-xs">
            {
              project.links.prod && (
                <a
                  href={project.links.prod}
                  class="underline focus-ring rounded"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Producción
                </a>
              )
            }
            {
              project.links.github && (
                <a
                  href={project.links.github}
                  class="underline focus-ring rounded"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  GitHub
                </a>
              )
            }
          </div>
        </div>
        <a
          href="/contacto"
          class="block text-center bg-primary text-bg px-6 py-3 rounded-full font-medium focus-ring"
          >¿Proyecto similar? Hablemos →</a
        >
      </div>
    </div>
  </div>
</Layout>
