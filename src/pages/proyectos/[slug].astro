---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { projects } from '../../content/projects';

export async function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
---

<Layout title={`${project.title} — Alexendros`} description={project.short}>
  <div class="mx-auto max-w-4xl px-6 pt-12 pb-16">
    <div class="text-xs text-muted">
      <a href="/proyectos" class="hover:text-fg focus-ring rounded">Casos</a> / {project.title}
    </div>
    <h1 class="mt-3 text-4xl font-bold">{project.title}</h1>
    <p class="mt-3 text-muted">{project.summary}</p>
    <Image
      src={project.cover}
      alt=""
      widths={[800, 1200]}
      sizes="(max-width: 768px) 100vw, 800px"
      class="mt-6 w-full rounded-2xl border border-border"
      loading="eager"
    />
    <div class="mt-4 flex flex-wrap gap-2">
      {
        project.results.map((r) => (
          <span class="text-xs bg-primary/10 text-primary border border-primary/20 rounded-full px-3 py-1">
            {r}
          </span>
        ))
      }
    </div>

    <div class="mt-10 grid md:grid-cols-[1.2fr_0.8fr] gap-10">
      <div class="space-y-8 text-sm">
        <div>
          <h2 class="font-bold">El punto de partida</h2>
          <p class="text-muted mt-1">{project.context}</p>
        </div>
        <div>
          <h2 class="font-bold">El reto</h2>
          <p class="text-muted mt-1">{project.challenge}</p>
        </div>
        <div>
          <h2 class="font-bold">Qué se hizo</h2>
          <p class="text-muted mt-1">{project.solution}</p>
        </div>
        <div>
          <h2 class="font-bold">Qué incluyó el trabajo</h2>
          <ul class="list-disc pl-5 text-muted space-y-1 mt-1">
            {project.responsibilities.map((r) => <li>{r}</li>)}
          </ul>
        </div>
      </div>
      <div class="space-y-6 cv-auto">
        <div class="border border-border rounded-2xl p-5 bg-card">
          <h2 class="font-bold text-sm">Aspectos clave</h2>
          <ul class="mt-2 list-disc pl-5 text-xs text-muted space-y-1">
            {project.highlights.map((h) => <li>{h}</li>)}
          </ul>
        </div>
        <details class="border border-border rounded-2xl p-5 bg-card">
          <summary class="font-bold text-sm cursor-pointer focus-ring rounded"
            >Detalles técnicos</summary
          >
          <div class="mt-3 space-y-2 text-xs text-muted">
            {project.technologies.map((t) => <p>{t}</p>)}
          </div>
        </details>
        <div class="border border-border rounded-2xl p-5 bg-card">
          <h2 class="font-bold text-sm">Enlaces</h2>
          <div class="mt-2 flex gap-3 text-xs">
            {
              project.links.prod && (
                <a
                  href={project.links.prod}
                  class="underline focus-ring rounded"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Ver en vivo
                </a>
              )
            }
            {
              project.links.github && (
                <a
                  href={project.links.github}
                  class="underline focus-ring rounded"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Código
                </a>
              )
            }
          </div>
        </div>
        <a
          href="/contacto"
          class="block text-center bg-primary text-bg px-6 py-3 rounded-full font-medium focus-ring"
          >Cuéntame un proyecto similar</a
        >
      </div>
    </div>
  </div>
</Layout>
