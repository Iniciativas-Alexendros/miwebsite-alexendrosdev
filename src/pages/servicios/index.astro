---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../content/services';
---

<Layout
  title="Cómo puedo ayudarte — Alexendros"
  description="Web nueva o renovación, revisión y plan de mejora, y plan digital con automatización. Alcance, plazos y precios desde claros."
>
  <div class="mx-auto max-w-6xl px-6 pt-12">
    <h1 class="text-4xl font-bold">Cómo puedo ayudarte</h1>
    <p class="text-muted mt-3 max-w-2xl">
      Tres formas de trabajar juntas: una web nueva o renovada, una revisión con plan de mejora, o
      un plan digital antes de invertir. En cada una verás qué incluye, qué no y desde cuánto.
    </p>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      {services.map((s) => <ServiceCard service={s} />)}
    </div>
  </div>
</Layout>
