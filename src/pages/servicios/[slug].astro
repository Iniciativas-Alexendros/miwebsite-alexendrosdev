---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../content/services';
export async function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props;
---

<Layout title={`${service.title} — Alexendros`} description={service.short}>
  <div class="mx-auto max-w-4xl px-6 pt-12 pb-16">
    <div class="text-xs text-muted">
      <a href="/servicios" class="hover:text-fg focus-ring rounded">Cómo puedo ayudarte</a> / {
        service.title
      }
    </div>
    <h1 class="mt-3 text-4xl font-bold">{service.title}</h1>
    <p class="mt-3 text-muted">{service.short}</p>
    <p class="mt-4 text-sm text-muted">{service.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      <span class="text-xs bg-primary text-bg rounded-full px-3 py-1"
        >{service.pricingFrom} · {service.timeline}</span
      >
    </div>

    <div class="mt-10 space-y-8">
      <div>
        <h2 class="font-bold">¿Para quién?</h2>
        <p class="mt-2 text-sm text-muted">{service.audience}</p>
      </div>

      <div>
        <h2 class="font-bold">¿Qué problema resuelve?</h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
          {service.problems.map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-bold">¿Qué incluye?</h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
          {service.scope.map((s) => <li>{s}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-bold">¿Qué recibes?</h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
          {service.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-bold">¿Qué no incluye?</h2>
        <ul class="mt-2 list-disc pl-5 text-sm text-muted space-y-1">
          {service.exclusions.map((e) => <li>{e}</li>)}
        </ul>
      </div>

      <div>
        <h2 class="font-bold">Cómo trabajamos</h2>
        <ol class="mt-2 list-decimal pl-5 text-sm text-muted space-y-1">
          {service.process.map((p) => <li>{p}</li>)}
        </ol>
      </div>

      <details class="border border-border rounded-2xl p-5 bg-card">
        <summary class="font-bold cursor-pointer focus-ring rounded">Detalles técnicos</summary>
        <div class="mt-3 space-y-2 text-sm text-muted">
          {service.technologies.map((t) => <p>{t}</p>)}
        </div>
      </details>

      <a
        href={service.cta}
        class="inline-block bg-primary text-bg px-6 py-3 rounded-full font-medium focus-ring"
        >Solicita información sobre este servicio</a
      >
    </div>
  </div>
</Layout>
