---
import { Image } from 'astro:assets';
import type { Project } from '../content/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---

<a
  href={`/proyectos/${project.slug}`}
  class="border border-border rounded-2xl overflow-hidden hover:border-primary/40 transition bg-card group flex flex-col focus-ring"
>
  <Image
    src={project.cover}
    alt=""
    widths={[400, 800]}
    sizes="(max-width: 768px) 100vw, 400px"
    class="w-full h-40 object-cover border-b border-border"
    loading="lazy"
  />
  <div class="p-6 flex-1">
    <div class="flex justify-between gap-3">
      <h2 class="font-bold text-base group-hover:text-primary transition">{project.title}</h2>
      <span class="text-[10px] text-muted">{project.published}</span>
    </div>
    <p class="mt-2 text-sm text-muted">{project.short}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {
        project.results.map((r) => (
          <span class="text-xs bg-primary/10 text-primary border border-primary/20 rounded-full px-2 py-1">
            {r}
          </span>
        ))
      }
    </div>
  </div>
  <div class="border-t border-border px-6 py-3 text-xs flex justify-between text-muted">
    <span>{project.role}</span><span aria-hidden="true">→</span>
  </div>
</a>
