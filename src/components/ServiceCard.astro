---
interface Props {
  service: import('../content/services').Service;
}
const { service } = Astro.props;
---

<a
  href={`/servicios/${service.slug}`}
  class="group border border-border rounded-2xl p-6 hover:border-primary/40 transition bg-card flex flex-col focus-ring"
>
  <div class="flex justify-between items-start gap-4">
    <h2 class="font-bold text-lg leading-tight group-hover:text-primary transition">
      {service.title}
    </h2>
    <span class="text-xs border border-border rounded-full px-2 py-1 shrink-0"
      >{service.pricingFrom}</span
    >
  </div>
  <p class="mt-3 text-sm text-muted">{service.short}</p>
  <div class="mt-4 flex gap-2 flex-wrap">
    {
      service.metrics.map((m) => (
        <span class="text-xs bg-bg border border-border rounded-full px-2 py-1">
          {m.label}: <b>{m.value}</b>
        </span>
      ))
    }
  </div>
  <div class="mt-4 text-xs text-muted">{service.timeline}</div>
  <div class="mt-auto pt-4 text-sm font-medium">Ver qué incluye →</div>
</a>
