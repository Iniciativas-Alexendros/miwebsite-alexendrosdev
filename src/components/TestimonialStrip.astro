---
import { testimonials } from '../content/testimonials';
---

<section class="mx-auto max-w-6xl px-6 mt-16 cv-auto" aria-labelledby="testimonials-heading">
  <h2 id="testimonials-heading" class="text-2xl font-bold">Lo que dicen clientes</h2>
  <p class="text-sm text-muted mt-2">
    Prueba social cerca de la decisión. Placeholders hasta testimonios firmados.
  </p>
  <div class="mt-6 grid md:grid-cols-3 gap-6">
    {
      testimonials.map((t) => (
        <figure class="border border-border rounded-2xl p-5 bg-card flex flex-col gap-4">
          <blockquote class="text-sm text-muted leading-relaxed">“{t.quote}”</blockquote>
          <figcaption class="mt-auto flex items-center gap-3">
            <img
              src={t.photo}
              alt=""
              width="40"
              height="40"
              class="rounded-full border border-border"
              loading="lazy"
            />
            <div>
              <div class="text-sm font-medium">{t.name}</div>
              <div class="text-xs text-muted">
                {t.role ? `${t.role} · ` : ''}
                {t.company}
              </div>
            </div>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
